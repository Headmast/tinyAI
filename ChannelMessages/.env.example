# Telegram API credentials (get at https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Your phone number (with country code, e.g. +79001234567)
PHONE_NUMBER=+7XXXXXXXXXX

# Session file name (will be created automatically on first run)
SESSION_NAME=channel_stats

# Database URL (SQLite by default; for Postgres use postgresql+psycopg://user:pass@host/db)
DB_URL=sqlite+aiosqlite:///channel_stats.db
